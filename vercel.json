{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/ai.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    },
    "api/research.mjs": {
      "maxDuration": 60
    },
    "api/feeds.mjs": {
      "maxDuration": 60
    },
    "api/youtube.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/ai?__route=chat" },
    { "source": "/api/rank-items", "destination": "/api/ai?__route=rank-items" },
    { "source": "/api/summary", "destination": "/api/ai?__route=summary" },
    { "source": "/api/paper-titles", "destination": "/api/ai?__route=summary&paperTitles=1" },
    { "source": "/api/creative-papers-feed", "destination": "/api/research?__route=creative-papers-feed" },
    { "source": "/api/papers-feed", "destination": "/api/research?__route=papers-feed" },
    { "source": "/api/wikipedia", "destination": "/api/research?__route=wikipedia" },
    { "source": "/api/news-feed", "destination": "/api/feeds?__route=news-feed" },
    { "source": "/api/recommendations", "destination": "/api/feeds?__route=recommendations" },
    { "source": "/api/rss", "destination": "/api/feeds?__route=rss" },
    { "source": "/api/twitch-eventsub", "destination": "/api/feeds?__route=twitch-eventsub" },
    { "source": "/api/twitch-feed", "destination": "/api/feeds?__route=twitch-feed" },
    { "source": "/api/twitch-oauth", "destination": "/api/feeds?__route=twitch-oauth" },
    { "source": "/api/weather-rain", "destination": "/api/feeds?__route=weather-rain" },
    { "source": "/api/instagram-profile", "destination": "/api/feeds?__route=instagram-profile" },
    { "source": "/api/instagram-image", "destination": "/api/feeds?__route=instagram-image" },
    { "source": "/api/instagram-video", "destination": "/api/feeds?__route=instagram-video" },
    { "source": "/api/instagram-stories", "destination": "/api/feeds?__route=instagram-stories" },
    { "source": "/api/youtube-feed", "destination": "/api/youtube" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
